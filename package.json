{
  "name": "stale-overrides",
  "version": "0.0.0",
  "description": "Tell when a dependency override is no longer needed, for npm, Yarn, Bun and pnpm",
  "keywords": [
    "bun",
    "cli",
    "npm",
    "overrides",
    "pnpm",
    "resolutions",
    "yarn"
  ],
  "homepage": "https://github.com/marcalexiei/stale-overrides#readme",
  "bugs": {
    "url": "https://github.com/marcalexiei/stale-overrides/issues"
  },
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcalexiei/stale-overrides.git"
  },
  "bin": {
    "stale-overrides": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "node src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:coverage": "vitest --run --config vitest.config.coverage.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:knip": "knip",
    "lint:publish": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm && publint --strict",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-all": "pnpm run build && pnpm run test:coverage && pnpm run format:check && pnpm run lint && pnpm run lint:knip && pnpm run lint:publish && pnpm run typecheck",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.9.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.44.1",
    "lefthook": "2.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24 || >=26"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
